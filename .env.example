# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / Neon)
# Runtime queries should use Neon’s pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST-pooler/YOUR_DATABASE?sslmode=require
# Prisma migrations should use the direct, unpooled connection string.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-NEON-HOST/YOUR_DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/YOUR_DATABASE?sslmode=require

# Application URLs
# Local: http://localhost:5173
# Render: https://YOUR-RENDER-SERVICE.onrender.com
APP_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Leave empty when frontend and backend share one origin. For split Render
# services, set this to the public backend origin, without a trailing slash.
VITE_API_URL=

# Paste Configuration
MAX_PASTE_SIZE_BYTES=524288
PASTE_EXPIRY_HOURS=24
CLEANUP_INTERVAL_MINUTES=60

# Free-Tier Capacity Limits
# Maximum active paste storage in MB (default 500 MB)
MAX_STORAGE_MB=500
# Maximum active paste count (default 2,000)
MAX_ACTIVE_PASTES=2000

# Rate Limiting (Configurable)
RATE_LIMIT_CREATE_WINDOW_MS=3600000
RATE_LIMIT_CREATE_MAX=10
RATE_LIMIT_CREATE_DAILY_WINDOW_MS=86400000
RATE_LIMIT_CREATE_DAILY_MAX=30
RATE_LIMIT_READ_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_DELETE_WINDOW_MS=60000
RATE_LIMIT_DELETE_MAX=20

# Tests/local troubleshooting only. Keep false or unset in production.
SKIP_RATE_LIMIT=false

# Google AdSense Monetization (Disabled by default)
# Set VITE_ADS_ENABLED=true only after site is approved by Google AdSense
VITE_ADS_ENABLED=false
VITE_ADSENSE_PUBLISHER_ID=
VITE_ADSENSE_HOME_SLOT_ID=
VITE_ADSENSE_VIEW_SLOT_ID=
