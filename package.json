{
  "name": "codeshare-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "seo:generate": "node scripts/generate-seo-assets.mjs",
    "seo:indexnow": "node scripts/indexnow.mjs",
    "build:shared": "npm --workspace=shared run build",
    "build:backend": "npm --workspace=backend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "build": "npm run seo:generate && npm run build:shared && npm run build:backend && npm run build:frontend",
    "start": "npm --workspace=backend run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "npm --workspace=backend run prisma:generate",
    "prisma:migrate": "npm --workspace=backend run prisma:migrate"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8"
  }
}
